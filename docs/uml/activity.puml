@startuml activity
title COLORS Web Application - Activity Diagram\n(Log In, Search Colors, Add Color, Log Out)

|User|
start
:Open index.html;
repeat
  :Enter username and password;
  :Click "Do It";
  |Browser (code.js)|
  :doLogin(): build JSON {login, password};
  note right
    The md5() call is commented out,
    so the password is sent as typed.
  end note
  :POST to Login.php;
  |PHP API|
  :Load DB settings from config.php
  and connect to MySQL;
  if (Connection error?) then (yes)
    :Return {id: 0, firstName: (empty),
    lastName: (empty), error: connect_error};
  else (no)
    |MySQL Database|
    :SELECT ID, firstName, lastName
    FROM Users
    WHERE Login = ? AND Password = ?;
    |PHP API|
    if (Row found?) then (yes)
      :Return {id, firstName, lastName, error: (empty)};
    else (no)
      :Return {id: 0, firstName: (empty),
      lastName: (empty), error: "No Records Found"};
    endif
  endif
  |Browser (code.js)|
  :Parse JSON response;
  :userId = response.id;
  backward:Show "User/Password combination incorrect";
repeat while (userId < 1?) is (yes)
->no;
:saveCookie(): store firstName, lastName,
userId (expires in 20 minutes);
:Redirect to color.html;
:readCookie() on DOMContentLoaded;
if (userId found in cookie?) then (no)
  :Redirect to index.html;
  stop
else (yes)
endif

repeat
  |User|
  switch (Choose action)
  case (Search)
    :Type search text and click "Search Color";
    |Browser (code.js)|
    :searchColor(): POST {search, userId} to SearchColors.php;
    |PHP API|
    :Load DB settings from config.php
    and connect to MySQL;
    if (Connection error?) then (yes)
      :Return {id: 0, firstName: (empty),
      lastName: (empty), error: connect_error} with
      no results array;
    else (no)
      |MySQL Database|
      :SELECT Name FROM Colors
      WHERE Name LIKE '%search%'
      AND UserID = ?;
      |PHP API|
      if (Any rows?) then (yes)
        :Return {results: [names], error: (empty)};
      else (no)
        :Return {id: 0, firstName: (empty),
        lastName: (empty), error: "No Records Found"} with
        no results array;
      endif
    endif
    |Browser (code.js)|
    :Show "Color(s) has been retrieved";
    if (results array present?) then (yes)
      :Display matching colors in #colorList;
    else (no)
      :JavaScript error reading results.length,
      so the color list is not updated;
    endif
  case (Add)
    |User|
    :Type color name and click "Add Color";
    |Browser (code.js)|
    :addColor(): POST {color, userId} to AddColor.php;
    |PHP API|
    :Load DB settings from config.php
    and connect to MySQL;
    if (Connection error?) then (yes)
      :Return {error: connect_error};
    else (no)
      |MySQL Database|
      :INSERT INTO Colors (UserId, Name)
      VALUES (?, ?);
      |PHP API|
      :Return {error: (empty)};
    endif
    |Browser (code.js)|
    :Show "Color has been added";
    note right
      The response's error field
      is not checked.
    end note
  endswitch
  |User|
repeat while (Do another action?) is (yes)
->no;
:Click "Log Out";
|Browser (code.js)|
:doLogout(): clear user variables
and expire the cookie;
:Redirect to index.html;
stop
@enduml
